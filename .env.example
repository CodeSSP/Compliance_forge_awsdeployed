# ---- CockroachDB ----------------------------------------------------------
# CockroachDB Cloud (must be v25.2+ for the VECTOR type):
#   CRDB_DSN=postgresql://user:pass@cluster.ap-south-1.aws.cockroachlabs.cloud:26257/complianceforge?sslmode=verify-full
# Local single node:
#   cockroach start-single-node --insecure --listen-addr=localhost:26257
CRDB_DSN=postgresql://root@localhost:26257/complianceforge?sslmode=disable
CRDB_POOL_MAX=16

# ---- AWS ------------------------------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET=
S3_REGULATION_PREFIX=regulations/pdf/
S3_KMS_KEY_ID=
SQS_QUEUE_URL=

# ---- Models ---------------------------------------------------------------
# MODEL_BACKEND: bedrock | sagemaker | ollama   (gemini is an escape hatch only)
MODEL_BACKEND=ollama
BEDROCK_MODEL_ID=
SAGEMAKER_GEN_ENDPOINT=

# EMBED_BACKEND: sagemaker | ollama
# Must stay on nomic-embed-text: regulatory_chunks is VECTOR(768) nomic.
# Changing the embedding model means editing schema.sql and re-embedding.
EMBED_BACKEND=ollama
SAGEMAKER_EMBED_ENDPOINT=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- L7 -------------------------------------------------------------------
TEXTRACT_ENABLED=false

# ---- L6 -------------------------------------------------------------------
AUDIT_SHARD=ap-south-1

APP_ENV=development
